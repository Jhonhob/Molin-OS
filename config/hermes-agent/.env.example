# ═══════════════════════════════════════════════════════════
# Hermes Agent（墨麟 OS）— 环境变量模板
# 复制到 ~/.hermes/.env 并填入真实密钥
# ═══════════════════════════════════════════════════════════

# ── AI 模型提供商（至少填一个） ──────────────────────────────────────────
# DeepSeek — 墨麟 OS 主模型
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# 通义千问 / DashScope（阿里云）
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# ── 飞书集成（消息推送、通知） ──────────────────────────────────────────
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=your-feishu-app-secret
FEISHU_VERIFICATION_TOKEN=your-verification-token

# ── 代码同步与技能商店 ──────────────────────────────────────────────────
GITHUB_TOKEN=ghp_your-github-personal-access-token

# ── 记忆服务（Supermemory，可选） ───────────────────────────────────────
SUPERMEMORY_API_KEY=sm_your-supermemory-api-key

# ── 多模型路由（OpenRouter，可选） ──────────────────────────────────────
# 提供 300+ 模型统一 API 入口
# OPENROUTER_API_KEY=sk-or-your-openrouter-key

# ── 网关权限 ─────────────────────────────────────────────────────────────
# 设为 true 则允许所有用户访问网关（不自名单限制）
GATEWAY_ALLOW_ALL_USERS=true

# ── SOP 自动化 ───────────────────────────────────────────────────────────
SOP_AUTOMATION_ENABLED=true

# ── 以下为可选配置 ──────────────────────────────────────────────────────

# ChromaDB 持久化目录（记忆向量库）
# CHROMADB_PERSIST_DIR=~/.hermes/memory/chroma_db

# 闲鱼 Cookie（墨声客服用）
# XIANYU_COOKIE=your-xianyu-cookie

# 小红书 Cookie（内容发布用）
# XHS_COOKIE=your-xhs-cookie

# FFmpeg 路径（视频处理）
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# 终端超时（秒）
# TERMINAL_TIMEOUT=60

# 浏览器会话超时（秒）
# BROWSER_SESSION_TIMEOUT=300
