# ═══════════════════════════════════════════════════════════
# 墨麟 OS · shared 共享线 — 环境变量模板
# 复制到 ~/.hermes/profiles/shared/.env
# ═══════════════════════════════════════════════════════════

SUPERMEMORY_API_KEY=***      # 记忆服务密钥
DEEPSEEK_API_KEY=***         # AI 模型密钥
DASHSCOPE_API_KEY=***        # 通义千问密钥
GATEWAY_ALLOW_ALL_USERS=true # 网关开放权限
